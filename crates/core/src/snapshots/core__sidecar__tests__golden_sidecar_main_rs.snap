// Generated by wrap-swap sidecar. Review before use. No module logic is ported.
// Protocol: one JSON request per line on stdin -> one JSON response per line on stdout.
// request:  {"id":N,"module":"...","method":"...","args":[...]}
// response: {"id":N,"ok":true,"result":...} | {"id":N,"ok":false,"error":"..."}
use std::io::{BufRead, Write};

fn main() {
let stdin = std::io::stdin();
let mut stdout = std::io::stdout();
for line in stdin.lock().lines() {
let line = match line { Ok(l) => l, Err(_) => break };
if line.trim().is_empty() { continue; }
let resp = handle(&line);
let _ = writeln!(stdout, "{}", resp);
let _ = stdout.flush();
}
}

fn handle(request: &str) -> String {
let v: serde_json::Value = match serde_json::from_str(request) {
Ok(v) => v,
Err(e) => return format!("{{\"ok\":false,\"error\":\"bad json: {}\"}}", e),
};
let id = v.get("id").cloned().unwrap_or(serde_json::Value::Null);
let module = v.get("module").and_then(|m| m.as_str()).unwrap_or("");
match module {
        "serialport" => {
            // detected: commonly-native package `serialport`
            let _ = &id;
            todo!("port serialport to Rust")
        }
        "keytar" => {
            // detected: commonly-native package `keytar`
            let _ = &id;
            todo!("port keytar to Rust")
        }
other => format!("{{\"id\":{},\"ok\":false,\"error\":\"unknown module {}\"}}", id, other),
}
}
