// Generated by wrap-swap. Minimal stdio client for the sidecar process.
use std::io::{BufRead, BufReader, Write};
use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};

pub struct SidecarClient {
child: Child,
stdin: ChildStdin,
reader: BufReader<ChildStdout>,
next_id: u64,
}

impl SidecarClient {
pub fn spawn(exe: &str) -> std::io::Result<SidecarClient> {
let mut child = Command::new(exe)
.stdin(Stdio::piped())
.stdout(Stdio::piped())
.spawn()?;
let stdin = child.stdin.take().expect("stdin");
let stdout = child.stdout.take().expect("stdout");
Ok(SidecarClient { child, stdin, reader: BufReader::new(stdout), next_id: 1 })
}

pub fn call(&mut self, module: &str, method: &str, args: &str) -> std::io::Result<String> {
let id = self.next_id;
self.next_id += 1;
let req = format!(
"{{\"id\":{},\"module\":\"{}\",\"method\":\"{}\",\"args\":{}}}",
id, module, method, args
);
writeln!(self.stdin, "{}", req)?;
self.stdin.flush()?;
let mut line = String::new();
self.reader.read_line(&mut line)?;
Ok(line)
}

pub fn shutdown(mut self) {
let _ = self.child.kill();
}
}
